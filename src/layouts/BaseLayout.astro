---
import "../styles/global.css";
interface Props { title?: string; description?: string; image?: string; }
const {
  title = "CongTrinhSnap – Quản lý công trình",
  description = "Quản lý ảnh, video, hồ sơ và tiến độ công trình dễ dàng trên điện thoại.",
  image = "/images/og-default.svg"
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = new URL(image, Astro.site).toString();
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d6b55" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="CongTrinhSnap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua điều hướng</a>
    <slot />
  </body>
</html>
