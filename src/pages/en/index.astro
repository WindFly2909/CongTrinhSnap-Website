---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---
<BaseLayout lang="en" title="CongTrinhSnap – Construction Project Management" description="Organize construction photos, videos, drawings, notes and project reports in one easy-to-use Android app.">
<SiteHeader />
<main id="main">
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Construction project management</span><h1>Keep every project organized.</h1><p class="hero-copy">Bring construction photos, videos, drawings, notes and reports together in one easy-to-use Android app.</p><div class="hero-actions"><a class="button" href="/en/download">Explore the app <span>→</span></a><a class="button button-ghost" href="/en/features">View features</a></div><p class="hero-note">Manage Projects. Capture Progress. Stay Organized.</p></div><div class="hero-art"><img src="/images/hero-dashboard.svg" alt="Illustration of a construction project management app on a phone" width="760" height="650" /></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">One place for project information</span><h2>From the jobsite to your reports</h2><p>CongTrinhSnap helps construction professionals keep project information organized and easy to find.</p></div><div class="feature-grid">
<article class="feature-card"><div class="feature-icon">▦</div><h3>Multiple projects</h3><p>Keep information for each construction project in its own organized space.</p></article>
<article class="feature-card"><div class="feature-icon">▧</div><h3>Photos and videos</h3><p>Record construction progress and organize visual records by project.</p></article>
<article class="feature-card"><div class="feature-icon">⌕</div><h3>Drawings and documents</h3><p>Keep related files together for convenient reference.</p></article>
<article class="feature-card"><div class="feature-icon">☷</div><h3>Logs and notes</h3><p>Record work updates, important details and milestones.</p></article>
<article class="feature-card"><div class="feature-icon">⇄</div><h3>Team sharing</h3><p>Collaborate with members invited to a project.</p></article>
<article class="feature-card"><div class="feature-icon">▤</div><h3>PDF reports</h3><p>Compile project photos into reports for storage and sharing.</p></article>
</div></div></section>
<section class="section section-soft"><div class="container split"><div><span class="eyebrow">Stay on top of the work</span><h2>Project photos and documents, organized together</h2><p class="muted">Organize project materials by job instead of searching through scattered folders.</p><ul class="check-list"><li>Store project photos and videos</li><li>Manage drawings and related documents</li><li>Record notes and work updates</li><li>Create PDF photo reports</li></ul><a class="button" href="/en/features">Explore all features</a></div><div class="content-card"><span class="eyebrow">Built around real workflows</span><h3>From site records to project reports</h3><p class="muted">Keep a record of progress, find information and share what your team needs.</p></div></div></section>
<section class="section"><div class="container cta"><div><h2>Bring more structure to your projects</h2><p>Explore CongTrinhSnap and see how it can support your work.</p></div><a class="button" href="/en/download">Get the app →</a></div></section>
</main><SiteFooter />
</BaseLayout>
