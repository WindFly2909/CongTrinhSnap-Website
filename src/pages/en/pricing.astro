---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---
<BaseLayout lang="en" title="Free and Pro | CongTrinhSnap" description="Learn about the Free and Pro options in CongTrinhSnap.">
<SiteHeader /><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">Choose your plan</span><h1>Free and Pro</h1><p>Choose the option that fits the size and needs of your construction projects.</p></div></section>
<section class="section"><div class="container price-grid"><article class="price-card"><span class="eyebrow">Get started</span><h2>Free</h2><p class="muted">Try essential features with the usage limits of the free version.</p><ul><li>Manage projects within Free limits</li><li>Store and organize project materials</li><li>Use reports within applicable limits</li></ul></article><article class="price-card featured"><span class="eyebrow">More flexibility</span><h2>Pro</h2><p class="muted">For users who need higher limits and additional options.</p><ul><li>Higher limits under the Pro plan</li><li>Advanced reporting options</li><li>Access to Pro benefits in the app</li></ul></article></div><p class="muted" style="text-align:center;margin-top:25px">Actual limits, prices and benefits are shown in the current app version or Google Play before purchase. This website does not assume or advertise an unverified price.</p></section></main><SiteFooter />
</BaseLayout>
