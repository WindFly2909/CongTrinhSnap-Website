<BaseLayout lang="en" title="Terms of service | CongTrinhSnap" description={`Terms governing use of ${legal.appName} and its website.`}>
<SiteHeader /><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">Legal</span><h1>Terms of service</h1><p>Effective date: {legal.effectiveDate}.</p></div></section>
