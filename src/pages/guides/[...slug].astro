---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection,render } from "astro:content";
export async function getStaticPaths(){const guides=await getCollection("guides",({data})=>!data.draft);return guides.map(guide=>({params:{slug:guide.id},props:{guide}}));}
const {guide}=Astro.props; const {Content}=await render(guide);
---
<BaseLayout title={`${guide.data.title} | CongTrinhSnap`} description={guide.data.description}>
<SiteHeader /><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">{guide.data.category}</span><h1>{guide.data.title}</h1><p>{guide.data.description}</p></div></section><article class="prose"><Content /></article></main><SiteFooter />
</BaseLayout>
