---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection } from "astro:content";
const guides=(await getCollection("guides",({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Hướng dẫn sử dụng | CongTrinhSnap" description="Hướng dẫn sử dụng ứng dụng CongTrinhSnap từng bước.">
<SiteHeader /><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">Trung tâm hướng dẫn</span><h1>Sử dụng CongTrinhSnap</h1><p>Các hướng dẫn thực tế giúp bạn bắt đầu và khai thác ứng dụng hiệu quả.</p></div></section>
<section class="section"><div class="container card-grid">{guides.length ? guides.map(guide=><a class="content-card" href={`/guides/${guide.id}`}><span class="eyebrow">{guide.data.category}</span><h2>{guide.data.title}</h2><p>{guide.data.description}</p></a>) : <div class="empty-state">Các bài hướng dẫn đang được biên soạn.</div>}</div></section></main><SiteFooter />
</BaseLayout>
