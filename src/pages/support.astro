---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { legal } from "../data/legal";
const faqs = (await getCollection("faq")).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Hỗ trợ | CongTrinhSnap" description="Câu hỏi thường gặp và thông tin hỗ trợ CongTrinhSnap.">
<SiteHeader /><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">Trung tâm hỗ trợ</span><h1>Chúng tôi có thể giúp gì?</h1><p>Hỗ trợ ứng dụng CongTrinhSnap do {legal.legalName} vận hành dưới thương hiệu {legal.brandName}.</p></div></section>
<section class="section"><div class="container" style="max-width:820px"><h2>Câu hỏi thường gặp</h2>
{faqs.length ? faqs.map(item=><details class="content-card" style="margin:12px 0"><summary><strong>{item.data.question}</strong></summary><p>{item.data.answer}</p></details>) : <div class="empty-state">Nội dung FAQ đang được cập nhật.</div>}
<div class="content-card" style="margin-top:30px"><h2>Liên hệ hỗ trợ</h2><p>Email: <a href={"mailto:" + legal.supportEmail}><strong>{legal.supportEmail}</strong></a></p><p>Địa chỉ liên hệ: {legal.legalAddress}</p><p class="muted">Khi gửi yêu cầu, vui lòng mô tả vấn đề, đời máy và phiên bản ứng dụng. Không gửi mật khẩu, mã OTP, số thẻ hoặc dữ liệu công trình nhạy cảm nếu không cần thiết.</p><p class="muted">Đơn vị vận hành: {legal.legalName}, thương hiệu {legal.brandName}.</p></div>
<div class="content-card" style="margin-top:18px"><h2>Tài khoản và thông tin pháp lý</h2><ul><li><a href="/delete-account">Xóa tài khoản và dữ liệu</a></li><li><a href="/app-privacy">Chính sách quyền riêng tư của ứng dụng</a></li><li><a href="/privacy">Quyền riêng tư của website</a></li><li><a href={legal.playSubscriptionsUrl} rel="noopener noreferrer">Hủy hoặc quản lý gói Pro trên Google Play</a></li><li><a href="https://support.google.com/googleplay/answer/2479637" rel="noopener noreferrer">Yêu cầu hoàn tiền qua Google Play</a></li></ul></div>
</div></section></main><SiteFooter />
</BaseLayout>
