---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { legal } from "../data/legal";
---
<BaseLayout title="Điều khoản sử dụng | CongTrinhSnap" description="Thông tin về thời điểm công bố điều khoản sử dụng CongTrinhSnap.">
<SiteHeader />
<main id="main">
<section class="page-hero"><div class="container"><span class="eyebrow">Pháp lý</span><h1>Điều khoản sử dụng</h1></div></section>
<article class="prose">
<p>Điều khoản sử dụng sẽ được công bố trước khi ứng dụng phát hành.</p>
<p>Liên hệ: <a href={"mailto:" + legal.supportEmail}>{legal.supportEmail}</a></p>
</article>
</main>
<SiteFooter />
</BaseLayout>
